---
import Base from '../layouts/Base.astro';
import { ui, homeUrl } from '../data/site';
const t = ui.fr;
---

<Base lang="fr" title="404" altHref={homeUrl('en')}>
  <section class="nf wrap">
    <p class="mono">Erreur 404 · Error 404</p>
    <h1>{t.notFound.title}</h1>
    <p>{t.notFound.text}</p>
    <p class="mono">{ui.en.notFound.title} — {ui.en.notFound.text}</p>
    <div class="nf__cta">
      <a class="btn btn--solid" href={homeUrl('fr')}>{t.notFound.home}</a>
      <a class="btn" href={homeUrl('en')}>{ui.en.notFound.home}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: 18px;
    padding-top: 120px;
  }
  .nf h1 {
    font-size: clamp(2.6rem, 8vw, 6rem);
    font-stretch: 120%;
    text-transform: uppercase;
  }
  .nf__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
</style>
