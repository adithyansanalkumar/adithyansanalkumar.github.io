---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { projectUrl } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---

<Base lang="fr" title={p.title.fr} description={p.summary.fr} altHref={projectUrl('en', p.slug)} image={p.cover}>
  <ProjectDetail p={p} lang="fr" />
</Base>
