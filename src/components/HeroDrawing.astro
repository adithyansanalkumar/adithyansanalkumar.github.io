---
/* Animated schematic: double-flow air handling unit (CTA) with supply
   (blue) and return (orange) ductwork. Lines draw themselves on load,
   air "flows" along the ducts and the fan spins. Pure SVG + CSS/GSAP. */
interface Props { supply: string; ret: string; caption: string }
const { supply, ret, caption } = Astro.props;
---

<figure class="hd" aria-hidden="true">
  <svg viewBox="0 0 560 440" class="hd__svg">
    <!-- frame + crop marks -->
    <g class="hd__frame" data-draw>
      <path d="M10 10h40M10 10v40M550 10h-40M550 10v40M10 430h40M10 430v-40M550 430h-40M550 430v-40" />
    </g>

    <!-- Outdoor air in / exhaust out -->
    <g class="hd__thin" data-draw>
      <path d="M8 296h44" class="c-cool" marker-end="url(#arr-c)" />
      <path d="M52 352H8" class="c-warm" marker-end="url(#arr-w)" />
    </g>
    <text x="10" y="286" class="hd__lbl">AN</text>
    <text x="10" y="372" class="hd__lbl">AE</text>

    <!-- CTA casing -->
    <g class="hd__eq" data-draw>
      <rect x="56" y="270" width="214" height="108" />
      <path d="M110 270v108M160 270v108" />
      <!-- filter -->
      <path d="M66 282l14 12-14 12 14 12-14 12 14 12-14 12 14 12" />
      <!-- coil -->
      <rect x="120" y="284" width="30" height="80" />
      <path d="M120 296h30M120 308h30M120 320h30M120 332h30M120 344h30M120 356h30" />
      <!-- fan housing -->
      <circle cx="215" cy="324" r="36" />
    </g>
    <g class="hd__fan">
      <path d="M215 324c0-16 8-26 20-26-2 12-8 20-20 26zM215 324c14 8 18 20 12 30-10-6-14-16-12-30zM215 324c-14 8-26 6-32-4 12-6 22-4 32 4z" />
      <circle cx="215" cy="324" r="4" />
    </g>
    <text x="58" y="396" class="hd__lbl">F7</text>
    <text x="118" y="396" class="hd__lbl">BF/BC</text>
    <text x="196" y="396" class="hd__lbl">VENT.</text>

    <!-- SUPPLY duct (blue) -->
    <path class="duct duct--cool" d="M270 296H330V118H530" />
    <path class="flow flow--cool" d="M270 296H330V118H530" />
    <!-- supply diffusers -->
    <g class="hd__thin c-cool" data-draw>
      <path d="M400 118v28M480 118v28" />
      <rect x="384" y="146" width="32" height="12" />
      <rect x="464" y="146" width="32" height="12" />
      <path d="M384 146l32 12M416 146l-32 12M464 146l32 12M496 146l-32 12" />
    </g>

    <!-- RETURN duct (orange) -->
    <path class="duct duct--warm" d="M530 226H364V352H270" />
    <path class="flow flow--warm" d="M530 226H364V352H270" />
    <g class="hd__thin c-warm" data-draw>
      <path d="M440 226v-22M510 226v-22" />
      <rect x="424" y="192" width="32" height="12" />
      <rect x="494" y="192" width="32" height="12" />
      <path d="M428 192v12M434 192v12M440 192v12M446 192v12M452 192v12M498 192v12M504 192v12M510 192v12M516 192v12M522 192v12" />
    </g>

    <!-- dimension line -->
    <g class="hd__dim" data-draw>
      <path d="M330 80h200M330 72v16M530 72v16" />
      <path d="M326 84l8-8M526 84l8-8" />
    </g>
    <text x="430" y="70" class="hd__lbl" text-anchor="middle">L = 6,40 m</text>

    <!-- tags -->
    <text x="356" y="108" class="hd__tagtxt c-cool-f">{supply.toUpperCase()} · 18 °C</text>
    <text x="380" y="248" class="hd__tagtxt c-warm-f">{ret.toUpperCase()} · 24 °C</text>
    <text x="340" y="300" class="hd__lbl">Ø 400</text>
    <text x="374" y="300" class="hd__lbl" dx="0" dy="30">Ø 450</text>

    <!-- north arrow / scale bar -->
    <g class="hd__thin" data-draw>
      <path d="M470 400h60M470 396v8M490 396v8M510 396v8M530 396v8" />
    </g>
    <text x="470" y="420" class="hd__lbl">0  1  2  3 m</text>

    <defs>
      <marker id="arr-c" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="m-cool" />
      </marker>
      <marker id="arr-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="m-warm" />
      </marker>
    </defs>
  </svg>
  <figcaption class="mono">{caption}</figcaption>
</figure>

<style>
  .hd {
    margin: 0;
    position: relative;
  }
  .hd__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hd figcaption {
    margin-top: 8px;
    text-align: right;
  }
  .hd__frame path,
  .hd__eq,
  .hd__thin,
  .hd__dim {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.2;
    stroke-linecap: square;
  }
  .hd__eq {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .hd__dim {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .hd__fan {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 2.4s linear infinite;
  }
  .c-cool {
    stroke: var(--cool);
  }
  .c-warm {
    stroke: var(--warm);
  }
  .c-cool-f {
    fill: var(--cool);
  }
  .c-warm-f {
    fill: var(--warm);
  }
  .m-cool {
    fill: var(--cool);
  }
  .m-warm {
    fill: var(--warm);
  }
  .duct {
    fill: none;
    stroke-width: 14;
    stroke-linejoin: miter;
    opacity: 0.22;
  }
  .duct--cool {
    stroke: var(--cool);
  }
  .duct--warm {
    stroke: var(--warm);
  }
  .flow {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 2 14;
    animation: flow 1.1s linear infinite;
  }
  .flow--cool {
    stroke: var(--cool-2);
  }
  .flow--warm {
    stroke: var(--warm-2);
  }
  .hd__lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink-3);
    letter-spacing: 0.06em;
  }
  .hd__tagtxt {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -32;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow,
    .hd__fan {
      animation: none;
    }
  }
</style>
